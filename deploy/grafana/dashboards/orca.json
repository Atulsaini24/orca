     "expr": "histogram_quantile(0.5, sum by (le) (rate(orca_engine_advance_ms_bucket[5m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(orca_engine_advance_ms_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ],
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "Fleet utilisation and queue",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 8,
    "h": 8
